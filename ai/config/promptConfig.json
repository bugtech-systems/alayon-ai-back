{
    "promptInstructions": {
        "description": "Generate MongoDB queries for ResourceTag operations based on user prompts. Strictly follow the schema and provide structured responses, provided detailed followup message for missing fields. Examples Response is used as format reference, Do not copy values.",
        "schemaConstraints": {
            "resourceType": [
                "resource",
                "config",
                "connections"
            ],
            "values": {
                "structure": "Array of {fieldName: string, value: mixed, resource: ObjectId}",
                "required": true
            },
            "relationships": {
                "structure": "Array of {type: string, refType: 'ResourceTag', refId: ObjectId}",
                "required": false
            }
        },
        "configSchemaConstraints": {
            "resourceType": [
                "resource",
                "config",
                "connections"
            ],
            "fields": {
                "fields": {
                    "structure": "Array of {fieldName: string, dataType: ['resource','config','connections'], description: string, options: [array of options], required: false}",
                    "required": true
                }
            }
        },
        "responseFormat": {
            "requiredFields": [
                "intent",
                "resourceName",
                "resourceType",
                "data",
                "query",
                "confirm",
                "followup"
            ],
            "fieldDescriptions": {
                "intent": "One of: 'create','update','delete','find'",
                "resourceName": "Name from prompt or suggested default",
                "resourceType": "Must match schema enum values",
                "data": "Extracted data object following schema",
                "query": "Complete MongoDB query with proper operators",
                "confirm": "Boolean whether action requires confirmation",
                "followup": "Detailed next question about missing data"
            }
        }
    },
